Vagrant.configure("2") do |config| 
  config.vm.define "test" do |test| 
   test.vm.box = "debian/bookworm64" 
   test.vm.hostname = 'test' 
   test.vm.network "private_network", ip: "192.168.52.52", virtualbox__intnet: true 
   #test.vm.provision 
   test.vm.disk :disk, name: "disk", size: "20GB", primary: true 
  end 
  config.vm.provider "virtualbox" do |v| 
   v.memory = "2048" 
   v.cpus = 2 
  end 
end 
